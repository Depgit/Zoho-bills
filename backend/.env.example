PORT=5000
JWT_SECRET=change-me
# Encrypts the Zoho credentials stored in the database. Create: openssl rand -base64 32
# Keep it safe and the same across deploys — without it stored credentials can't be read.
ENCRYPTION_KEY=

# PostgreSQL. Local: `npm run db:up` (Docker, port 5433). Production: the Supabase connection string.
DATABASE_URL=postgres://zoho:zoho@127.0.0.1:5433/zoho_bills

# Bill file storage: local (./data/files — development) or supabase (production)
STORAGE_DRIVER=local
SUPABASE_URL=
# service_role key — server only, never ship it to the browser
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=bill-files

# AI providers for bill reading (at least one)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# optional model overrides: GEMINI_MODEL, DEEPSEEK_MODEL, GROQ_MODEL; GEMINI_MIN_GAP_MS=4500

# off = always extract fresh (no cache / no duplicate lookup)
EXTRACT_CACHE=on
# days a rejected bill keeps its uploaded file before it's deleted
REJECTED_FILE_DAYS=10

# true = log OCR text and AI answers
DEBUG_OCR=false

# Only for the one-off copy from MongoDB (npm run db:copy-from-mongo)
MONGO_URI=mongodb://127.0.0.1:27017/zoho_bills
